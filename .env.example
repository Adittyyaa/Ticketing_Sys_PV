# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ticketing_system

# JWT Authentication Secret
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here

# Incoming Ticket API Key (KEEP SECRET - Server-side only)
# Used by external apps to push tickets into the system via POST /api/tickets/incoming
TICKETING_API_KEY=your-incoming-api-key-here

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,text/plain

# Supabase Migration (Only needed if migrating from existing Supabase setup)
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Security Notes:
# 1. Never commit .env.local to version control
# 2. Use different keys for development and production
# 3. JWT_SECRET should be a strong random string
# 4. Rotate keys if compromised