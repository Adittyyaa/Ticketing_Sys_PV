{
  "name": "ticketing-system",
  "version": "1.0.0",
  "description": "Modern ticketing system with PostgreSQL",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "db:setup": "psql -f database-setup-postgresql.sql",
    "db:setup-production": "npx tsx scripts/setup-production-db.ts",
    "db:create-admin": "npx tsx scripts/setup-production-db.ts --create-admin",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:seed": "docker-compose exec app npx tsx scripts/setup-production-db.ts --create-admin --email admin@pvadvisory.com --password Admin123321 --name Admin",
    "docker:logs": "docker-compose logs -f app"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "@types/node": "^20.19.43",
    "antd": "^6.4.3",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "date-fns": "^2.30.0",
    "docker": "^1.0.0",
    "html2canvas": "^1.4.1",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^16.2.7",
    "pg": "^8.12.0",
    "postcss": "^8.4.31",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1",
    "zustand": "^4.4.1"
  }
}
