{
  "name": "ticketing-system",
  "version": "1.0.0",
  "description": "Modern ticketing system with PostgreSQL",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd frontend && npm run start",
    "start:backend": "cd backend && npm run start",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "db:setup": "cd backend && psql -f src/config/database-setup-postgresql.sql",
    "db:setup-production": "cd backend && npx tsx src/scripts/setup-production-db.ts",
    "db:create-admin": "cd backend && npx tsx src/scripts/setup-production-db.ts --create-admin",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:seed": "docker-compose exec app npx tsx backend/src/scripts/setup-production-db.ts --create-admin --email admin@pvadvisory.com --password Admin123321 --name Admin",
    "docker:logs": "docker-compose logs -f app"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "@supabase/supabase-js": "^2.38.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^9.0.8",
    "antd": "^6.4.3",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "date-fns": "^2.30.0",
    "docker": "^1.0.0",
    "html2canvas": "^1.4.1",
    "jose": "^5.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^16.2.7",
    "pg": "^8.12.0",
    "postcss": "^8.4.31",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1",
    "zustand": "^4.4.1"
  }
}
